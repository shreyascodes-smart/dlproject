# Copy to backend/.env and fill in. Never commit real values.

# Copernicus Data Space Ecosystem (live Sentinel-2 imagery) — https://dataspace.copernicus.eu/
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=

# Model and runtime (optional; defaults shown)
# DI_SEG_MODEL=segmentation_v2        # segmentation_v1 | segmentation_v2 (no fallback if missing)
# DI_DEVICE=auto                      # auto | cuda | cpu
# DI_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
# DI_RATE_LIMIT_ASSESS=12             # assessments per client per minute
# DI_MAX_BODY_BYTES=16384

# Frontend build (frontend/.env.local), only if the API is on another origin:
# VITE_API_URL=https://api.example.org
# Dev/preview proxy target (default http://127.0.0.1:8000):
# VITE_PROXY_TARGET=http://127.0.0.1:8000
